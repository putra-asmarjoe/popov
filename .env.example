# MongoDB — main database (tickets, incident memory, audit trails, sessions)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=popovagent_db

# MySQL: Popov does not store its own data in MySQL. If a monitored service keeps its
# logs in MySQL, configure its connection in the Web UI (Workspace Settings → Services).
# Optional global fallback credentials can still be set via env vars:
#   MYSQL_HOST / MYSQL_PORT / MYSQL_USER / MYSQL_PASSWORD / MYSQL_DB

# Centralized OpenTelemetry Log Database (app_logs_db — span_logs + http_logs).
# Used by the span agent to look up trace details. Kept separate from project databases.

# Telegram bot credentials are NOT set here.
# They are managed per-workspace in the Web UI: Workspace Settings → "Notifications"
# (multiple bots supported; each bot can be linked to different projects).
# Migrating an existing env-based bot:
#   python scripts/import_env_telegram.py --workspace-id <ObjectId>
# Optional override for mock testing / self-hosted Telegram API proxy:
# TELEGRAM_API_BASE=https://api.telegram.org

# LLM & Embedding — bring your own key (BYOK): all config is managed via the UI → DB.
# Provider options: openai | openrouter | google | opencode  (see /management?tab=apikeys)
#   - Provider, model, API key, and base URL are stored in the `llm_settings` collection.
#   - API keys are encrypted with Fernet using DATA_ENCRYPTION_KEY below (required!).
#   - Changes take effect immediately, no restart needed. There are NO LLM_PROVIDER/
#     LLM_MODEL/OPENAI_API_KEY/OPENROUTER_API_KEY/GOOGLE_API_KEY/OPENCODE_API_KEY/
#     OPENCODE_BASE_URL env vars anymore.
#   - Each provider's base URL is editable (defaults are pre-filled) — e.g. opencode:
#     /zen/go/v1 for the 'go' MiMo-V2.5 model, /zen/v1 for gemini/gpt/claude.
# Embedding: choose Local Only (TF cosine, no API) or reuse an already-configured
# LLM provider and just pick an embedding model.

# Master encryption key for sensitive data in the DB (LLM/embedding API keys). REQUIRED.
# Generate it (do NOT lose it — encrypted keys cannot be decrypted without it):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=change-me-to-a-generated-fernet-key

# --- FALLBACK (bootstrap while `llm_settings` DB is empty) — normally leave unset ---
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GOOGLE_API_KEY=
# OPENCODE_API_KEY=
# OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# Embedding — Second Brain (episodic memory)
# provider: local | openrouter | openai
# local = TF cosine without any API call (default fallback, zero cost)
# openrouter + liquid = free, 1024-dim, 512 ctx, 135M free tokens
#   LFM2.5-Embedding-350M by Liquid AI (Aug 18, 2026) via OpenRouter
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free
EMBEDDING_DIM=1024
EMBEDDING_TIMEOUT_MS=3000
EMBEDDING_MAX_CHARS=8000

# Deploy Event (Gap 4) — auto-cleanup TTL for CI/CD deploy signals
# deploy_events are auto-deleted after X hours (MongoDB TTL index)
DEPLOY_EVENT_TTL_HOURS=2

# Verification Agent (epic Gap 5) — closed-loop post-fix check
# Delay before re-check after ticket moves to in_progress/needs_review (minutes)
VERIFICATION_DELAY_MINUTES=10
# Watchdog scan interval (seconds)
VERIFICATION_INTERVAL_SEC=60
# Leave empty to use the provider's default URL; set only if self-hosting:
# EMBEDDING_API_URL=https://openrouter.ai/api/v1

# Knowledge Agent — Gap 1: relevance-based retrieval tuning
# MAX_TOTAL_CHARS: total character budget across all knowledge docs sent to Correlation Agent.
#   Increase if Correlation Agent needs richer context (costs more tokens).
# MAX_ITEM_CHARS: per-document truncation limit — individual docs beyond this are cut.
# TOP_K: max number of docs returned by vector search (bypass docs are always included).
# THRESHOLD: minimum cosine similarity score for a doc to be included (0.0–1.0).
#   Lower = more docs included, higher = stricter matching. Floor rule: always ≥1 doc.
# MIN_QUERY_LEN: if the assembled query text is shorter than this (chars), skip vector
#   search and fall back to keyword overlap + service-name matching.
KNOWLEDGE_MAX_TOTAL_CHARS=8000
KNOWLEDGE_MAX_ITEM_CHARS=2000
KNOWLEDGE_TOP_K=5
KNOWLEDGE_THRESHOLD=0.3
KNOWLEDGE_MIN_QUERY_LEN=10

# API Key Rate Limits (per hour, in-memory sliding window)
# Default limits for web and public API keys. Can be overridden per-key via UI.
API_KEY_RATE_LIMIT_WEB=1000
API_KEY_RATE_LIMIT_PUBLIC=200

# Loki — deployment detection (read-only K8s events query, namespace=default)
LOKI_TIMEOUT_MS=2500
LOKI_NAMESPACE=default

# Observability (GLOBAL DEFAULTS / FALLBACK)
# ⚠️ With multi-observability support, these URLs are only used as fallback when a
#    project is NOT linked to an Observability Stack. Manage stacks per workspace/
#    project in the Web UI (/management → "Stacks" tab).
OBSERVABILITY_TIMEOUT_MS=5000
OBSERVABILITY_ENABLED=true
OBSERVABILITY_INTERVAL_MIN=5
# Alert noise filter for the watchdog (comma = list). Empty disables the filter.
OBSERVABILITY_IGNORE_ALERTNAMES=Watchdog
OBSERVABILITY_IGNORE_SEVERITIES=none

# Auto-ticket dedup window (hours): alerts with identical content within this window
# are linked to the same ACTIVE ticket (1 ticket : N alerts, `ticket_alerts` collection).
# Outside the window / ticket resolved|closed → a new ticket is created. 0 = no time limit.
TICKET_ALERT_DEDUP_HOURS=12

# Autonomous Investigation Loop (CHATFLOW V2.1) — when the correlation agent's
# confidence is below the threshold and some data lanes were skipped, Popov
# automatically fetches the missing data before sending the final report.
# Set to false to disable (rollback without redeploy):
#   - the router always goes straight to the final report
#   - chips + confidence block still appear
# POPOV_AUTONOMOUS_LOOP=true

# JWT auth — web frontend. CHANGE to a long random string in production!
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_HOURS=24

# App
APP_DEBUG=false
