{
  "name": "popov-web",
  "private": true,
  "version": "0.2.0-rc161",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others -n API,WEB -c green,yellow \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:all": "concurrently --kill-others -n API,WEB,WDT -c green,yellow,red \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:watchdog\"",
    "dev:backend": "cd .. && ./venv/bin/uvicorn main:app --reload --port 8000",
    "dev:frontend": "vite",
    "dev:watchdog": "cd .. && ./venv/bin/python watchdog_worker.py",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "highlight.js": "^11.12.0",
    "i18next": "^26.4.0",
    "i18next-http-backend": "^4.0.1",
    "interactjs": "^1.10.28",
    "lucide-react": "^1.33.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "react-i18next": "^17.0.12",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  },
  "description": "Popov - The Intelligence Behind Operations frontend (React/Vite)"
}
