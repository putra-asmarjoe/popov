# Opsional — default sudah benar untuk dev (Vite proxy) & prod (diserve FastAPI).
# Isi hanya jika frontend dan backend di-deploy di domain berbeda.
VITE_API_BASE_URL=/api/v1

# Realtime WebSocket (dipakai mulai FE-4)
VITE_WS_BASE_URL=ws://localhost:8000/api/v1

# Deep-link TraceID ke Grafana Tempo (dipakai mulai FE-6)
VITE_TRACE_ID_BASE_URL=http://grafana:3000/explore?traceId=
